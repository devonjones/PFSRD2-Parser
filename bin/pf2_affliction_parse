#!/usr/bin/env python
import sys

from pfsrd2.affliction import AFFLICTION_TYPES, parse_affliction
from universal.options import exec_main, option_parser


def main():
    valid_types = list(AFFLICTION_TYPES.keys())
    valid_types_str = ", ".join(valid_types)
    usage = (
        f"usage: %(prog)s [options] TYPE [filenames]\n"
        f"Parses afflictions ({valid_types_str}) from pfsrd2 html to json"
    )
    parser = option_parser(usage)
    parser.add_argument(
        "--type",
        dest="subtype",
        choices=valid_types,
        help=f"Affliction type: {valid_types_str} (can also be the first positional argument)",
    )
    options = parser.parse_args()
    args = options.files

    if not options.subtype:
        if args and args[0] in valid_types:
            options.subtype = args[0]
            args = args[1:]
        else:
            parser.error(
                f"Affliction type required as first argument or --type flag "
                f"(one of: {valid_types_str})"
            )

    exec_main(options, args, parse_affliction, AFFLICTION_TYPES[options.subtype])


if __name__ == "__main__":
    sys.exit(main())
